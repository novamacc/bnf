---
/** Lotus divider between major sections. */
interface Props { tone?: 'ink' | 'gold' }
const { tone = 'ink' } = Astro.props;
---
<div class={`lotus-divider lotus-${tone}`} aria-hidden="true">
  <span class="lotus-line"></span>
  <svg viewBox="0 0 64 28" width="64" height="28" focusable="false">
    <g fill="none" stroke="currentColor" stroke-width="1.1" stroke-linejoin="round">
      <path d="M32 3c5 5 6 13 0 21-6-8-5-16 0-21z" />
      <path d="M32 24c-2-8-8-13-15-14 0 8 6 13 15 14z" />
      <path d="M32 24c2-8 8-13 15-14 0 8-6 13-15 14z" />
      <path d="M32 24c-7-3-15-3-22 1 6 3 14 3 22-1z" />
      <path d="M32 24c7-3 15-3 22 1-6 3-14 3-22-1z" />
      <path d="M12 26h40" />
    </g>
  </svg>
  <span class="lotus-line"></span>
</div>
