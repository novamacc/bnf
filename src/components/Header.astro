---
import Img from './Img.astro';
import { dict, url, type Lang } from '../i18n';

interface Props { lang: Lang; altHref: string; current: string }
const { lang, altHref, current } = Astro.props;
const t = dict(lang);
const other = lang === 'en' ? 'zh' : 'en';
const items = [
  ['about', t.nav.about], ['programmes', t.nav.programmes], ['wisdom', t.nav.wisdom],
  ['community', t.nav.community], ['events', t.nav.events], ['volunteer', t.nav.volunteer], ['visit', t.nav.visit],
] as const;
const isCurrent = (k: string) => current === k || (k === 'programmes' && current.startsWith('programmes'));
---
<header class="site-header" data-header>
  <div class="wrap header-inner">
    <a class="brand" href={url(lang)} aria-label={t.name}>
      <Img k="2022/05/logo-1.png" cap={360} sizes="48px" class="brand-logo" eager />
      <span class="brand-text"><span class="brand-name">{t.name}</span><span class="brand-tag">{t.tagline}</span></span>
    </a>
    <nav class="main-nav" aria-label={t.menu}>
      <ul>
        {items.map(([k, label]) => (
          <li><a href={url(lang, k)} aria-current={isCurrent(k) ? 'page' : undefined}>{label}</a></li>
        ))}
      </ul>
    </nav>
    <div class="header-tools">
      <button class="icon-btn" type="button" data-search-open aria-label={t.search.open}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.6"/><path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        <kbd class="kbd">⌘K</kbd>
      </button>
      <a class="icon-btn lang-btn" href={altHref} hreflang={other === 'zh' ? 'zh-Hans' : 'en'} lang={other === 'zh' ? 'zh-Hans' : 'en'} data-lang-switch aria-label={t.langSwitchLabel}>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.6 2.6 3.8 5.6 3.8 9s-1.2 6.4-3.8 9c-2.6-2.6-3.8-5.6-3.8-9S9.4 5.6 12 3z"/></g></svg>
        <span>{t.langSwitch}</span>
      </a>
      <a class="btn btn-small btn-saffron header-donate" href={url(lang, 'donate')}>{t.nav.donate}</a>
      <button class="icon-btn menu-btn" type="button" data-menu-open aria-expanded="false" aria-controls="drawer" aria-label={t.menu}>
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M4 8h16M4 16h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>
</header>
<div class="drawer" id="drawer" hidden>
  <div class="drawer-inner">
    <button class="icon-btn drawer-close" type="button" data-menu-close aria-label={t.close}>
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
    </button>
    <ul class="drawer-nav">
      <li><a href={url(lang)} data-menu-close>{t.nav.home}</a></li>
      {items.map(([k, label]) => <li><a href={url(lang, k)} data-menu-close aria-current={isCurrent(k) ? 'page' : undefined}>{label}</a></li>)}
      <li><a href={url(lang, 'donate')} data-menu-close>{t.nav.donate}</a></li>
    </ul>
    <a class="drawer-lang" href={altHref} data-lang-switch hreflang={other === 'zh' ? 'zh-Hans' : 'en'}>{t.langSwitch}</a>
  </div>
</div>
